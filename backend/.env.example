# ====================================================================
# CLUCKO BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# For Render Web Service Deployment & Supabase PostgreSQL
# ====================================================================

# Database Configuration (Supabase PostgreSQL Connection Pooler)
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SSLMODE=require
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (For Invitation Email Redirects & Direct Sign-in)
# Set to your Vercel deployment URL (e.g. https://clucko-admin.vercel.app)
FRONTEND_URL=https://your-admin-app.vercel.app

# PayMongo (GCash / Card / Maya)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here

# App settings
PORT=5000
DEBUG=False
FLASK_ENV=production

# EmailJS & SMTP Configuration (For Admin Welcome / Caretaker Invites)
EMAILJS_SERVICE_ID=service_lzrjxzb
EMAILJS_TEMPLATE_ID=template_u0b0yl9
EMAILJS_WELCOME_TEMPLATE_ID=template_welcome
EMAILJS_USER_ID=lJJPMqktLrmyBcQBJ

SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Master SuperAdmin (Developer Root Access)
SUPERADMIN_EMAIL=superadmin@clucko.com
SUPERADMIN_PASSWORD=your_strong_superadmin_password
SUPERADMIN_NAME=Platform Developer (SuperAdmin)
